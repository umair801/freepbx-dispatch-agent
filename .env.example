# AgAI-33 environment variables

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Asterisk ARI / AMI (NEW in AgAI-33 -- point at your local Dockerized
# FreePBX for development, or a real PBX once available)
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=agai33
ASTERISK_AMI_SECRET=your_ami_secret
ASTERISK_ARI_BASE_URL=http://127.0.0.1:8088/ari
ASTERISK_ARI_USERNAME=agai33
ASTERISK_ARI_SECRET=your_ari_secret
ASTERISK_ARI_APP_NAME=agai33_dispatch

# Twilio (SMS/WhatsApp only in AgAI-33 -- voice moved to Asterisk)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@yourdomain.com

# Google Geocoding (NEW in AgAI-33 -- technician proximity ranking)
GOOGLE_API_KEY=your_google_api_key

# ElevenLabs (NEW in AgAI-33 -- TTS/STT bridge for Asterisk calls)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
